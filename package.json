{
  "name": "tarih-yapragi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Seçtiğin gün için tarihteki olaylar, doğanlar, kaybettiklerimiz, karanlık dosyalar ve bilim dönüm noktaları — yayıncılar için hazır sohbet kartlarıyla.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nazukhimes/TarihinYapragi.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && vite build",
    "analyze": "npm run sitemap && cross-env ANALYZE=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sitemap": "node scripts/sitemap.mjs",
    "icons": "node scripts/generate-brand-assets.mjs",
    "siniflandirma": "node scripts/siniflandirma-raporu.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "kontrol": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
